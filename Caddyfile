{
	# 双站点边缘代理：{$DOMAIN} → liteshop 应用；{$PAY_DOMAIN} → LitePay 网关
	# 域名来自 compose 注入的环境变量（.env 里的 DOMAIN / PAY_DOMAIN，必填）
	# pay 站点要求 litepay 容器与 caddy 处在同一 docker 网络（部署时 docker network connect）
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

{$DOMAIN} {
	reverse_proxy app:3000
	import security_headers
	encode zstd gzip
}

{$PAY_DOMAIN} {
	reverse_proxy litepay:3000
	import security_headers
	encode zstd gzip
}
