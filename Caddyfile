{
	# 双站点边缘代理：shop.9527.tr → liteshop；pay.9527.tr → litepay
}

shop.9527.tr {
	reverse_proxy liteshop:3000

	header {
		X-Frame-Options DENY
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	@api path /api/*
	header @api Cache-Control "no-store"

	encode zstd gzip
}

pay.9527.tr {
	reverse_proxy litepay:3000

	header {
		X-Frame-Options DENY
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	encode zstd gzip
}
