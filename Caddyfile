{
	# 双站点边缘代理：shop.9527.tr → liteshop 应用；pay.9527.tr → LitePay 网关
	# pay 站点依赖 litepay 容器所在的 liteshop_default 网络（部署时 docker network connect）
}

shop.9527.tr {
	reverse_proxy app:3000

	header {
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	encode zstd gzip
}

pay.9527.tr {
	reverse_proxy litepay:3000

	header {
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	encode zstd gzip
}
