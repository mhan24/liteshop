# 前台对外访问地址（用户浏览器可访问）
SHOP_PUBLIC_BASE_URL=http://localhost:8080
# 发卡系统监听地址与 SQLite 路径
SHOP_LISTEN_ADDR=:8080
SHOP_DATABASE_PATH=data/shop.db
TZ=Asia/Shanghai

# 后台管理员（首次启动写入数据库；修改 SHOP_ADMIN_PASSWORD 不会自动更新已存在的管理员）
SHOP_ADMIN_USERNAME=admin
SHOP_ADMIN_PASSWORD=change-me-admin-password
SHOP_SESSION_SECRET=change-me-session-secret

# Cloudflare Turnstile（secret 只从环境变量读取，不要提交真实值）
TURNSTILE_SECRET=
TURNSTILE_SITE_KEY=0x4AAAAAAD-83GuuhsY2-KeZ

# BEpusdt 对接
BEPUSDT_BASE_URL=http://localhost:8081
# BEpusdt 后台：系统设置 -> 基本设置 -> API 对接 -> API Token
BEPUSDT_API_TOKEN=change-me-bepusdt-api-token
# BEpusdt 回调发卡系统的地址。本机直接运行可留空（默认 SHOP_PUBLIC_BASE_URL + /notify/bepusdt）；
# Docker Compose 运行建议填 http://shop:8080/notify/bepusdt
BEPUSDT_NOTIFY_URL=
BEPUSDT_FIAT=CNY
# 单一收款类型（兼容旧配置）
BEPUSDT_TRADE_TYPE=usdt.trc20
# 可选：逗号分隔多个收款类型，前台下单时可选择；留空则只使用 BEPUSDT_TRADE_TYPE
# 示例：BEPUSDT_TRADE_TYPES=usdt.trc20,usdt.erc20,usdt.bep20,usdt.polygon,usdc.trc20
# 也可以在后台「设置」里修改；后台设置优先级高于此处。
BEPUSDT_TRADE_TYPES=
BEPUSDT_TIMEOUT_SEC=1200

# 邮件通知（可选）
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Telegram 管理通知（可选）
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
