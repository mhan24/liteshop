# ===== 运行环境 =====
NODE_ENV=production
PORT=3000
# 对外站点地址（用于 canonical / sitemap / 支付回跳）
SITE_URL=https://shop.example.com

# ===== 安全（必填）=====
# 会话/令牌签名密钥：openssl rand -hex 32
AUTH_SECRET=
# 管理员用户名
ADMIN_USER=admin
# 管理员密码哈希（scrypt）：npm run hash-password -- <密码> 生成后粘贴
ADMIN_PASSWORD_HASH=
# 后台入口伪装路径（默认 /admin；可改为任意前缀降低扫描暴露面）
ADMIN_PATH=/admin

# ===== 数据库（compose 内网）=====
DATABASE_URL=postgres://liteshop:liteshop@db:5432/liteshop

# ===== 定时任务 =====
# /api/cron/maintenance 专用密钥：openssl rand -hex 32（未设置则接口一律 403；cron 容器以 Authorization: Bearer 头调用）
CRON_SECRET=

# ===== 部署（docker compose）=====
# 数据库口令（compose 内网；改后需同步 DATABASE_URL）
POSTGRES_PASSWORD=liteshop
# Caddy 自动 HTTPS 域名（必填；DOMAIN 必须与 SITE_URL 的域名一致，部署脚本会校验）
DOMAIN=shop.example.com
# LitePay 网关对外域名（同一 Caddy 反代；不填默认 pay.9527.tr）
PAY_DOMAIN=pay.example.com

# ===== 支付 =====
# auto：使用后台「设置 · 支付网关」配置的 LitePay 网关
# mock：进程内模拟支付，仅限开发与测试（收银台在 /pay/mock）
PAYMENT_DRIVER=auto
