# ===== liteshop 环境配置 =====
# 复制为 .env 后填写；docker compose 会自动读取

# 对外端口（compose 映射用）
PORT=3000

# ===== 安全（必填）=====
# 会话签名密钥：openssl rand -hex 32
AUTH_SECRET=
# 管理员用户名
ADMIN_USER=admin
# 管理员密码哈希（scrypt）：npm run hash-password -- <你的密码> 生成后粘贴
ADMIN_PASSWORD_HASH=

# ===== 支付 =====
# mock：本地模拟收银台（开发用，/pay/mock 路由可见）
# bepusdt：强制走 bepusdt
# auto（默认）：使用后台「设置 → 支付渠道」中启用的渠道
PAYMENT_DRIVER=auto

# 站点对外地址（用于构造支付回调 notify_url；后台设置里配置的 site_url 优先级更高）
SITE_URL=https://shop.example.com

# ===== 数据 =====
# 本地开发时的 SQLite 目录（容器内固定为 /app/data）
# DATA_DIR=./data

# ===== 定时任务 =====
# /api/cron/* 专用密钥：openssl rand -hex 32
# 与 AUTH_SECRET 隔离——泄露它不会危及管理会话签名。
# 未设置时 /api/cron/* 一律 401（超时订单仍由惰性清扫兜底）。
CRON_SECRET=
