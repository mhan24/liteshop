# ===== 运行环境 =====
NODE_ENV=production
PORT=3000
# 对外站点地址（用于 canonical / sitemap / 支付回跳）
SITE_URL=https://shop.example.com

# ===== 安全（必填）=====
# 会话/令牌签名密钥：openssl rand -hex 32
AUTH_SECRET=
# 管理员用户名
ADMIN_USER=admin
# 管理员密码哈希（scrypt）：npm run hash-password -- <密码> 生成后粘贴
ADMIN_PASSWORD_HASH=
# 后台入口伪装路径（默认 /admin；可改为任意前缀降低扫描暴露面）
ADMIN_PATH=/admin

# ===== 数据库（compose 内网）=====
DATABASE_URL=postgres://liteshop:liteshop@db:5432/liteshop

# ===== 定时任务 =====
# /api/cron/maintenance 专用密钥：openssl rand -hex 32（未设置则接口 401）
CRON_SECRET=

# ===== 部署（docker compose）=====
# 数据库口令（compose 内网；改后需同步 DATABASE_URL）
POSTGRES_PASSWORD=liteshop
# Caddy 自动 HTTPS 域名
DOMAIN=shop.example.com

# ===== 支付 =====
# mock：本地模拟支付（开发用）；auto：使用后台启用的支付渠道
PAYMENT_DRIVER=auto
