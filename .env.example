# LiteShop Docker 部署配置
# 复制为 .env 并按需修改: cp .env.example .env

# 必填: 站点域名 (Caddy 自动签发 HTTPS)
DOMAIN=shop.example.com

# 可选: Go 模块代理 (国内服务器保持默认 goproxy.cn)
GOPROXY=https://goproxy.cn,direct

# 可选: npm 镜像
NPM_REGISTRY=https://registry.npmmirror.com

# 可选: BEpusdt 回调地址 (默认 https://<DOMAIN>/notify/bepusdt)
# BEPUSDT_NOTIFY_URL=https://shop.example.com/notify/bepusdt

# 可选: 前台公开地址 (默认 https://<DOMAIN>)
# SHOP_PUBLIC_BASE_URL=https://shop.example.com

# 可选: 初始化令牌 (设置后 /setup 必须携带该令牌才能完成初始化, 防止站点暴露期间被抢占)
# SHOP_SETUP_TOKEN=please-change-me

# 镜像标签
TAG=latest
