# 部署凭证（仅 scripts/deploy.sh 读取，与应用运行时完全隔离）
#
# 该文件不得提交到版本库；权限建议 chmod 600。
# 优先使用 SSH 密钥：留空 SSH_PASSWORD 即可（此时需要 ssh-agent 或默认私钥）。
#   本地生成并上传公钥：
#     ssh-keygen -t ed25519 -f ~/.ssh/liteshop_deploy
#     ssh-copy-id -i ~/.ssh/liteshop_deploy.pub root@<host>
#   然后在 ~/.ssh/config 指定 IdentityFile 即可免密部署。

SSH_HOST=
SSH_PORT=22
SSH_USER=root
SSH_PASSWORD=
REMOTE_DIR=/opt/liteshop
COMPOSE_FILES="-f docker-compose.yml -f docker-compose.caddy.yml"
