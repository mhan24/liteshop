# 部署凭证（仅 scripts/deploy.sh 读取，与应用运行时完全隔离；不得提交到版本库，建议 chmod 600）
#
# 认证使用 SSH 密钥（脚本以 BatchMode 运行，不支持密码登录）：
#   ssh-keygen -t ed25519 -f ~/.ssh/liteshop_deploy
#   ssh-copy-id -i ~/.ssh/liteshop_deploy.pub root@<host>
#   然后在 ~/.ssh/config 为该主机指定 IdentityFile。

SSH_HOST=
SSH_PORT=22
SSH_USER=root
REMOTE_DIR=/opt/liteshop
# 对外站点地址（部署前用它校验服务器 .env 的 DOMAIN）
SITE_URL=https://shop.9527.tr
# CI 推送的镜像仓库
IMAGE_REPO=ghcr.io/mhan24/liteshop
