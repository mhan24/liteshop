# 异地备份（offsite 容器读取；复制为服务器上的 /opt/liteshop/.env.offsite 并 chmod 600）
#
# 结构：offsite（加密层）→ store（实际存储）。文件在本机加密后才上传，存储服务商只看到密文。
# 下面以 Cloudflare R2 / 任意 S3 兼容存储为例；其它存储（B2、阿里云 OSS、SFTP 等）
# 把 STORE 段换成对应类型即可，参考 https://rclone.org/overview/
#
# 生成加密口令（必须经 rclone obscure 处理，直接写明文会无法解密）：
#   docker run --rm rclone/rclone:1 obscure '你的长随机口令'
# 原始口令请另外妥善保存（密码管理器）——服务器整机丢失时，要靠它解密远端备份。

# ---- 实际存储（S3 兼容）----
RCLONE_CONFIG_STORE_TYPE=s3
RCLONE_CONFIG_STORE_PROVIDER=Cloudflare
RCLONE_CONFIG_STORE_ACCESS_KEY_ID=
RCLONE_CONFIG_STORE_SECRET_ACCESS_KEY=
RCLONE_CONFIG_STORE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
RCLONE_CONFIG_STORE_NO_CHECK_BUCKET=true

# ---- 加密层（offsite 容器只认这个名字）----
RCLONE_CONFIG_OFFSITE_TYPE=crypt
RCLONE_CONFIG_OFFSITE_REMOTE=store:liteshop-backups
RCLONE_CONFIG_OFFSITE_PASSWORD=
RCLONE_CONFIG_OFFSITE_FILENAME_ENCRYPTION=off

# 远端保留天数
OFFSITE_KEEP_DAYS=30
