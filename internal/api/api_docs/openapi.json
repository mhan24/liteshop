{
  "openapi": "3.0.3",
  "info": {
    "title": "LiteShop API",
    "description": "LiteShop 自动发卡系统 API。公共端点无需认证；管理端点需先登录获取会话 Cookie（角色要求：admin / operator / viewer）。支付回调路径可在后台配置（默认 /notify/bepusdt）。",
    "version": "0.1.0",
    "contact": { "name": "LiteShop", "url": "https://github.com/mhan24/liteshop" }
  },
  "servers": [{ "url": "/" }],
  "tags": [
    { "name": "public", "description": "公开端点（前台）" },
    { "name": "admin", "description": "管理端点（需登录，按角色分级）" },
    { "name": "webhook", "description": "支付网关回调" }
  ],
  "security": [],
  "components": {
    "securitySchemes": {
      "sessionCookie": { "type": "apiKey", "in": "cookie", "name": "shop_session", "description": "登录后由服务端设置的会话 Cookie" }
    },
    "schemas": {
      "Error": { "type": "object", "properties": { "error": { "type": "string" } } },
      "Ok": { "type": "object", "properties": { "ok": { "type": "boolean" } } },
      "Product": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string" },
          "slug": { "type": "string" },
          "description": { "type": "string" },
          "image_url": { "type": "string" },
          "price_cents": { "type": "integer" },
          "status": { "type": "string", "enum": ["active", "disabled"] },
          "category": { "type": "string" },
          "sort_order": { "type": "integer" },
          "is_pinned": { "type": "boolean" },
          "faq": { "type": "array", "items": { "type": "object", "properties": { "q": { "type": "string" }, "a": { "type": "string" } } } },
          "wholesale": { "type": "array", "items": { "type": "object", "properties": { "min_qty": { "type": "integer" }, "discount": { "type": "integer" } } } },
          "min_qty": { "type": "integer" },
          "max_qty": { "type": "integer" },
          "cost_cents": { "type": "integer", "description": "仅管理端返回" },
          "created_at": { "type": "integer" },
          "updated_at": { "type": "integer" }
        }
      },
      "ProductView": {
        "type": "object",
        "properties": {
          "product": { "$ref": "#/components/schemas/Product" },
          "available": { "type": "integer" },
          "reserved": { "type": "integer" },
          "sold": { "type": "integer" }
        }
      },
      "Order": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "order_no": { "type": "string" },
          "product_id": { "type": "integer" },
          "product_name": { "type": "string" },
          "qty": { "type": "integer" },
          "amount_cents": { "type": "integer" },
          "fiat": { "type": "string" },
          "trade_type": { "type": "string" },
          "buyer_contact": { "type": "string" },
          "status": { "type": "string" },
          "payment_status": { "type": "string", "description": "支付生命周期（created / pending / confirmed / failed / cancelled），与订单状态解耦" },
          "trade_id": { "type": "string" },
          "payment_url": { "type": "string" },
          "block_transaction_id": { "type": "string" },
          "created_at": { "type": "integer" },
          "updated_at": { "type": "integer" },
          "paid_at": { "type": "integer" }
        }
      },
      "Card": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "product_id": { "type": "integer" },
          "reserved_order": { "type": "integer" },
          "sold_order": { "type": "integer" },
          "content": { "type": "string" },
          "status": { "type": "string" },
          "created_at": { "type": "integer" },
          "updated_at": { "type": "integer" },
          "sold_at": { "type": "integer" }
        }
      },
      "Coupon": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "code": { "type": "string" },
          "type": { "type": "string", "enum": ["fixed", "percent"] },
          "value_cents": { "type": "integer" },
          "percent": { "type": "integer" },
          "min_amount_cents": { "type": "integer" },
          "max_uses": { "type": "integer" },
          "used_count": { "type": "integer" },
          "product_id": { "type": "integer" },
          "active": { "type": "boolean" },
          "expires_at": { "type": "integer" },
          "created_at": { "type": "integer" }
        }
      },
      "AuditLog": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "admin_id": { "type": "integer" },
          "username": { "type": "string" },
          "action": { "type": "string" },
          "target_type": { "type": "string" },
          "target_id": { "type": "string" },
          "before": { "type": "string" },
          "after": { "type": "string" },
          "created_at": { "type": "integer" }
        }
      },
      "Admin": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "username": { "type": "string" },
          "role": { "type": "string", "enum": ["admin", "operator", "viewer"] },
          "created_at": { "type": "integer" }
        }
      },
      "JobRun": {
        "type": "object",
        "properties": {
          "job_name": { "type": "string" },
          "status": { "type": "string", "enum": ["running", "ok", "error"] },
          "started_at": { "type": "integer" },
          "finished_at": { "type": "integer" },
          "error": { "type": "string" }
        }
      },
      "SiteInfo": {
        "type": "object",
        "properties": {
          "title": { "type": "string" },
          "subtitle": { "type": "string" },
          "public_base_url": { "type": "string" },
          "announcement": { "type": "string" },
          "seo_description": { "type": "string" },
          "seo_keywords": { "type": "string" },
          "links": { "type": "array", "items": { "type": "object" } },
          "copyright": { "type": "string" },
          "lang": { "type": "string" },
          "locale": { "type": "string" },
          "currency": { "type": "string" },
          "currency_symbol": { "type": "string" },
          "timezone": { "type": "string" },
          "stock_display_mode": { "type": "string" },
          "home_view_mode": { "type": "string" },
          "default_product_image": { "type": "string" },
          "turnstile_site_key": { "type": "string" },
          "logo_url": { "type": "string" },
          "favicon_url": { "type": "string" },
          "maintenance": { "type": "object", "properties": { "enabled": { "type": "boolean" }, "message": { "type": "string" } } }
        }
      },
      "OrderCreateRequest": {
        "type": "object",
        "required": ["product_id", "contact", "cf-turnstile-response"],
        "properties": {
          "product_id": { "type": "integer" },
          "qty": { "type": "integer", "default": 1 },
          "contact": { "type": "string", "format": "email" },
          "trade_type": { "type": "string" },
          "coupon_code": { "type": "string" },
          "cf-turnstile-response": { "type": "string" }
        }
      },
      "OrderCreateResponse": {
        "type": "object",
        "properties": {
          "order_no": { "type": "string" },
          "payment_url": { "type": "string" },
          "token": { "type": "string", "description": "查看令牌（邮件同步下发）" }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": ["username", "password"],
        "properties": {
          "username": { "type": "string" },
          "password": { "type": "string" },
          "otp": { "type": "string", "description": "TOTP 验证码（已启用双因素时）" }
        }
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "ok": { "type": "boolean" },
          "totp_required": { "type": "boolean" },
          "token": { "type": "string", "description": "TOTP 待验证令牌" }
        }
      },
      "SetupRequest": {
        "type": "object",
        "properties": {
          "site_title": { "type": "string" },
          "username": { "type": "string" },
          "password": { "type": "string" },
          "confirm": { "type": "string" },
          "public_base_url": { "type": "string" },
          "bepusdt_base_url": { "type": "string" },
          "bepusdt_api_token": { "type": "string" },
          "trade_types": { "type": "string" },
          "fiat": { "type": "string" },
          "turnstile_site_key": { "type": "string" },
          "turnstile_secret": { "type": "string" }
        }
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "tags": ["public"],
        "summary": "健康检查",
        "description": "返回应用名、版本、运行时长与组件状态（database / payment）；数据库故障时返回 503。",
        "responses": {
          "200": {
            "description": "OK",
            "content": { "application/json": { "schema": { "type": "object", "properties": { "ok": { "type": "boolean" }, "app": { "type": "string" }, "version": { "type": "string" }, "build": { "type": "string" }, "config_version": { "type": "integer", "description": "settings 配置版本" }, "uptime_sec": { "type": "integer" }, "database": { "type": "object", "properties": { "status": { "type": "string" }, "size_bytes": { "type": "integer" }, "migration_version": { "type": "integer" }, "last_backup": { "type": "object", "properties": { "file": { "type": "string" }, "modified": { "type": "integer" } } }, "integrity": { "type": "string", "enum": ["ok", "error"] } } }, "jobs": { "type": "object", "properties": { "mail_queue_size": { "type": "integer" }, "last_success": { "type": "integer" } } }, "payment": { "type": "string" } } } } }
          },
          "503": { "description": "数据库故障" }
        }
      }
    },
    "/api/v1/site": {
      "get": {
        "tags": ["public"],
        "summary": "站点信息",
        "description": "站点标题/副标题/公告/语言/货币/时区/维护状态/公开地址等前台配置。",
        "responses": { "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SiteInfo" } } } } }
      }
    },
    "/api/v1/products": {
      "get": {
        "tags": ["public"],
        "summary": "商品列表（分类分组）",
        "parameters": [
          { "name": "q", "in": "query", "schema": { "type": "string" }, "description": "关键词（名称/描述）" },
          { "name": "category", "in": "query", "schema": { "type": "string" } },
          { "name": "min_price", "in": "query", "schema": { "type": "number" } },
          { "name": "max_price", "in": "query", "schema": { "type": "number" } }
        ],
        "responses": {
          "200": {
            "description": "分类商品列表",
            "content": { "application/json": { "schema": { "type": "object", "properties": { "categories": { "type": "array", "items": { "type": "object", "properties": { "name": { "type": "string" }, "default_key": { "type": "string" }, "products": { "type": "array", "items": { "$ref": "#/components/schemas/ProductView" } } } } }, "categories_all": { "type": "array", "items": { "type": "string" } } } } } }
          }
        }
      }
    },
    "/api/v1/products/{id}": {
      "get": {
        "tags": ["public"],
        "summary": "商品详情",
        "description": "按 id 或 slug 查找上架商品，含库存/收款类型/Turnstile 站点密钥。",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "OK" }, "404": { "description": "not found" } }
      }
    },
    "/api/v1/orders": {
      "post": {
        "tags": ["public"],
        "summary": "创建订单",
        "description": "需 Turnstile 验证。创建订单并生成支付交易；100% 折扣券订单直接完成并发卡。",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OrderCreateRequest" } } }
        },
        "responses": {
          "200": { "description": "ok", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OrderCreateResponse" } } } },
          "400": { "description": "参数错误 / 库存不足", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "403": { "description": "Turnstile 验证失败" }
        }
      },
      "get": {
        "tags": ["public"],
        "summary": "按邮箱查询订单（模糊响应）",
        "description": "不返回订单号与查看链接；待支付订单含 payment_url。需 Turnstile（已配置时）。",
        "parameters": [{ "name": "contact", "in": "query", "required": true, "schema": { "type": "string", "format": "email" } }],
        "responses": { "200": { "description": "订单列表" } }
      }
    },
    "/api/v1/orders/links": {
      "post": {
        "tags": ["public"],
        "summary": "发送查看链接到邮箱",
        "description": "把该邮箱下全部订单的查看链接发送到登记邮箱（冷却 5 分钟/邮箱）。需 Turnstile（已配置时）。",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object", "required": ["contact"], "properties": { "contact": { "type": "string", "format": "email" } } } } }
        },
        "responses": { "200": { "description": "ok" }, "429": { "description": "发送过于频繁" } }
      }
    },
    "/api/v1/orders/{orderNo}": {
      "get": {
        "tags": ["public"],
        "summary": "订单详情（凭查看令牌访问卡密）",
        "description": "?token=<查看令牌> 为访问凭证；未校验归属时不返回邮箱/支付地址等敏感字段。",
        "parameters": [
          { "name": "orderNo", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "token", "in": "query", "schema": { "type": "string" }, "description": "查看令牌（邮件下发）" }
        ],
        "responses": { "200": { "description": "订单 + 卡密" }, "404": { "description": "not found" } }
      }
    },
    "/api/v1/orders/{orderNo}/cancel": {
      "post": {
        "tags": ["public"],
        "summary": "取消订单",
        "description": "凭查看令牌操作；释放卡密并同步关闭支付交易。",
        "parameters": [
          { "name": "orderNo", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "token", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "ok" }, "400": { "description": "当前状态不可取消" }, "403": { "description": "令牌不匹配" } }
      }
    },
    "/api/v1/pages/{slug}": {
      "get": {
        "tags": ["public"],
        "summary": "静态页（privacy / terms）",
        "parameters": [{ "name": "slug", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "页面内容" } }
      }
    },
    "/api/v1/lang": {
      "post": {
        "tags": ["public"],
        "summary": "设置语言 Cookie（zh / en）",
        "parameters": [{ "name": "lang", "in": "query", "schema": { "type": "string", "enum": ["zh", "en"] } }],
        "responses": { "200": { "description": "ok" } }
      }
    },
    "/api/v1/maintenance/unlock": {
      "post": {
        "tags": ["public"],
        "summary": "维护模式解锁",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object", "properties": { "password": { "type": "string" } } } } }
        },
        "responses": { "200": { "description": "ok" }, "403": { "description": "密码错误" } }
      }
    },
    "/api/v1/setup": {
      "get": {
        "tags": ["public"],
        "summary": "初始化状态检查",
        "responses": { "200": { "description": "{ initialized, site_title }" } }
      },
      "post": {
        "tags": ["public"],
        "summary": "首次初始化（创建管理员 + 写入配置）",
        "description": "敏感配置（支付 Token / Turnstile 密钥）加密存入 secrets 表。",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SetupRequest" } } }
        },
        "responses": { "200": { "description": "ok" }, "400": { "description": "已初始化或参数错误" } }
      }
    },
    "/notify/bepusdt": {
      "post": {
        "tags": ["webhook"],
        "summary": "支付网关回调",
        "description": "路径可在后台配置（默认 /notify/bepusdt）。MD5 验签后更新订单状态并发卡；status=2 支付成功，status=3 网关侧取消。",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object", "properties": { "order_id": { "type": "string" }, "trade_id": { "type": "string" }, "block_transaction_id": { "type": "string" }, "status": { "type": "string" }, "signature": { "type": "string" } } } } }
        },
        "responses": { "200": { "description": "ok" }, "400": { "description": "验签失败" } }
      }
    },
    "/api/v1/admin/login": {
      "post": {
        "tags": ["admin"],
        "summary": "管理员登录",
        "description": "成功设置会话 Cookie；已启用 TOTP 且未提供 otp 时返回 totp_required=true 与待验证 token。连续失败 5 次锁定 10 分钟。",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LoginRequest" } } }
        },
        "responses": { "200": { "description": "ok", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LoginResponse" } } } }, "403": { "description": "凭据错误 / 已锁定" } }
      }
    },
    "/api/v1/admin/login/verify": {
      "post": {
        "tags": ["admin"],
        "security": [],
        "summary": "TOTP 二次验证（登录第二步）",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object", "required": ["token", "otp"], "properties": { "token": { "type": "string" }, "otp": { "type": "string" } } } } }
        },
        "responses": { "200": { "description": "ok" }, "401": { "description": "token 失效" }, "403": { "description": "otp 错误" } }
      }
    },
    "/api/v1/admin/logout": {
      "post": {
        "tags": ["admin"],
        "security": [{ "sessionCookie": [] }],
        "summary": "退出登录（吊销会话）",
        "responses": { "200": { "description": "ok" } }
      }
    },
    "/api/v1/admin/session": {
      "get": {
        "tags": ["admin"],
        "security": [{ "sessionCookie": [] }],
        "summary": "当前会话（用户名 + 角色）",
        "responses": { "200": { "description": "ok", "content": { "application/json": { "schema": { "type": "object", "properties": { "ok": { "type": "boolean" }, "username": { "type": "string" }, "role": { "type": "string" } } } } } }, "401": { "description": "未登录" } }
      }
    },
    "/api/v1/admin/dashboard": {
      "get": {
        "tags": ["admin"],
        "security": [{ "sessionCookie": [] }],
        "summary": "运营仪表盘",
        "description": "今日订单/收入/毛利/发卡、库存统计、低库存、最近交易、系统状态（Go 版本/DB 大小/运行时长）。",
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/api/v1/admin/sales-report": {
      "get": {
        "tags": ["admin"],
        "security": [{ "sessionCookie": [] }],
        "summary": "销售报表",
        "description": "近 N 日营收曲线 + 商品销售占比 + 成本来源统计。",
        "parameters": [{ "name": "days", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 90, "default": 14 } }],
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/api/v1/admin/products": {
      "get": {
        "tags": ["admin"],
        "security": [{ "sessionCookie": [] }],
        "summary": "商品列表（含库存，全部状态）",
        "responses": { "200": { "description": "OK", "content": { "application/json": { "schema": { "type": "object", "properties": { "products": { "type": "array", "items": { "$ref": "#/components/schemas/ProductView" } } } } } } } }
      },
      "post": {
        "tags": ["admin"],
        "security": [{ "sessionCookie": [] }],
        "summary": "新建商品（需 operator+）",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Product" } } } },
        "responses": { "200": { "description": "ok" } }
      }
    },
    "/api/v1/admin/products/{id}": {
      "get": {
        "tags": ["admin"],
        "security": [{ "sessionCookie": [] }],
        "summary": "商品详情（管理端）",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": { "200": { "description": "OK" }, "404": { "description": "not found" } }
      }
    },
    "/api/v1/admin/products/{id}/edit": {
      "post": {
        "tags": ["admin"],
        "security": [{ "sessionCookie": [] }],
        "summary": "编辑商品（需 operator+）",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Product" } } } },
        "responses": { "200": { "description": "ok" } }
      }
    },
    "/api/v1/admin/products/{id}/cards": {
      "get": {
        "tags": ["admin"],
        "security": [{ "sessionCookie": [] }],
        "summary": "卡密列表",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
