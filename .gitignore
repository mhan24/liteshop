# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# 模板文件需要入库（供他人复制为 .env）
!.env.example
!.deploy.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# liteshop
/data
/backups
.env
.env.production
# 部署凭证（与应用 .env 分离；由 scripts/deploy.sh 读取）
.deploy.env
.deploy.env.local

# AI 会话规划文档（内部）
.zcode/
