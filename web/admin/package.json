    "lucide-vue-next": "^1.0.0",
    "md-editor-v3": "^6.5.5",
    "pinia": "^2.3.0",
    "qrcode": "^1.5.4",
    "reka-ui": "^2.10.3",
    "shadcn-vue": "^2.8.2",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
